# LLM Provider API Keys (Free Tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Embeddings Configuration
# Options: 'ollama' (recommended for VPS with nomic-embed-text), 'gemini', 'local' (zero-RAM N-gram fallback)
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Cache Settings
CACHE_TTL_SECONDS=300

# Server Ports
BROKER_PORT=3001
MEMORY_PORT=3002
MC_PORT=25565
