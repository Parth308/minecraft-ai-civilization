# ─── Civilization AI Stack — Environment Variables ─────────────────────────────
# Copy this to .env and fill in your keys.

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# Get keys:
#   Gemini:       https://aistudio.google.com/apikey            (free, ~20 req/day/model)
#   Groq:         https://console.groq.com/keys                 (free, 30 RPM, fast)
#   NVIDIA NIM:   https://build.nvidia.com                      (free prototyping, ~40 RPM)
#   Cerebras:     https://cloud.cerebras.ai                     (free, 1M tokens/day)
#   OpenRouter:   https://openrouter.ai/keys                    (free tier; $10 credit raises daily cap)
#   SiliconFlow:  ⚠️ CHINESE ID/+86 PHONE REQUIRED - skip unless you have one
#   Zhipu GLM:    ⚠️ CHINESE ID/+86 PHONE REQUIRED - skip (use OpenRouter for GLM/Qwen instead)
#   Mistral:      https://console.mistral.ai/api-keys           (~1B tokens/month free; phone verify; prompts may train models)
#   GitHub Models https://github.com/settings/personal-access-tokens (any PAT works; GPT-4o-mini free)
#   LiteRouter:   https://literouter.com                        (free: unlimited :free-model calls, ~7s cooldown)
#   TokenReply:   https://www.tokenreply.com                    (free models on Default tier; allowances check-in gated)
#   Pollinations: no key needed                                 (anonymous lane)
#   Cloudflare:   https://dash.cloudflare.com/                  (Workers AI: 10,000 free neurons/day)
#   HuggingFace:  https://huggingface.co/settings/tokens        (Serverless inference provider router)
#   Cohere:       https://dashboard.cohere.com/api-keys         (Free trial: 20 RPM, ~1,000 calls/month)
#   DashScope/Qwen: https://dashscope-intl.aliyuncs.com/        (1M free tokens per model, 90-day trial)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

CEREBRAS_API_KEY=
# ⚠️ Cerebras free quota exhausts fast (402 payment_required when spent). Key valid, needs billing tab reset or new account.
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B-Instruct

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GITHUB_MODELS_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# LiteRouter: unlimited :free-model calls (~7s cooldown).
LITEROUTER_API_KEY=
LITEROUTER_MODEL=deepseek-v3.2:free

# TokenReply: verified free IDs ('-free' suffix): gemini-3.7-flash-default-free
TOKENREPLY_API_KEY=
TOKENREPLY_MODEL=gemini-3.7-flash-default-free

POLLINATIONS_MODEL=openai

AGNES_API_KEY=
AGNES_MODEL=deepseek-v3

LLM7_API_KEY=unused
LLM7_MODEL=DeepSeek-V4-Flash-0731

# Cloudflare Workers AI (10,000 free neurons/day)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# HuggingFace Inference Router
HF_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cohere (20 RPM free tier)
COHERE_API_KEY=
COHERE_MODEL=command-a-02-2025

# Alibaba DashScope / Qwen International
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-flash

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Options: ollama | gemini | local | auto
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ─── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Dashboard + RCON & Ports ──────────────────────────────────────────────────
# Used by the dashboard service for operator chat and spectator bot setup.
# Must match the Minecraft server's RCON password (set in docker-compose).
RCON_PASSWORD=changeme
DASHBOARD_PORT=3003
BROKER_PORT=3001
MEMORY_PORT=3002
MC_PORT=25565
