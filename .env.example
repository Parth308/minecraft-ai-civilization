# ─── Civilization AI Stack — Environment Variables ─────────────────────────────
# Copy this to .env and fill in your keys.

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# Get keys:
#   Gemini:       https://aistudio.google.com/apikey            (free, ~20 req/day/model)
#   Groq:         https://console.groq.com/keys                 (free, 30 RPM, fast)
#   NVIDIA NIM:   https://build.nvidia.com                      (free prototyping, ~40 RPM)
#   Cerebras:     https://cloud.cerebras.ai                     (free, 1M tokens/day)
#   OpenRouter:   https://openrouter.ai/keys                    (free tier; $10 credit raises daily cap)
#   SiliconFlow:  https://cloud.siliconflow.cn/account/ak       (free models: Qwen3-8B, DS-R1-Distill-7B; CN/intl email signup OK)
#   Zhipu GLM:    https://open.bigmodel.cn/usercenter/apikeys   (GLM-4-Flash free; CN-first, may need +86 phone)
#   Mistral:      https://console.mistral.ai/api-keys           (~1B tokens/month free; phone verify; prompts may train models)
#   GitHub Models https://github.com/settings/personal-access-tokens (any PAT works; GPT-4o-mini free)
#   Pollinations: no key needed                                  (anonymous keyless last resort)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B-Instruct
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GITHUB_MODELS_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
POLLINATIONS_MODEL=openai
AGNES_API_KEY=
AGNES_MODEL=deepseek-v3
LLM7_API_KEY=unused
LLM7_MODEL=default

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Options: ollama | gemini | local | auto
EMBEDDING_PROVIDER=ollama
OLLAMA_MODEL=nomic-embed-text

# ─── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Dashboard + RCON ──────────────────────────────────────────────────────────
# Used by the dashboard service for operator chat and spectator bot setup.
# Must match the Minecraft server's RCON password (set in docker-compose).
RCON_PASSWORD=changeme
DASHBOARD_PORT=3003
