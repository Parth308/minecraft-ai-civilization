# ─── Civilization AI Stack — Environment Variables ─────────────────────────────
# Copy this to .env and fill in your keys.
# All providers are free-tier. No credit card required.

# ─── LLM Providers ─────────────────────────────────────────────────────────────

# Google Gemini (free, ~20 req/day/model)
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free, 30 RPM, fast — 429-flaky under load)
#   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM (free prototyping, ~40 RPM, ~9s avg — reasoning lane)
#   https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Cerebras (free, 1M tokens/day — quota exhausts fast, 402 when spent)
#   https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# OpenRouter (free tier; $10 credit raises daily cap)
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# SiliconFlow (permanent free models — needs Chinese ID/+86 phone)
#   https://siliconflow.cn
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B-Instruct

# Zhipu GLM (needs Chinese ID/+86 phone — use ZhipuAI below instead)
#   https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# Mistral (~1B tokens/month free; phone verify; prompts may train models)
#   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# LiteRouter (unlimited :free-model calls, ~7s cooldown)
#   https://literouter.com
LITEROUTER_API_KEY=
LITEROUTER_MODEL=deepseek-v3.2:free

# Ollama Cloud (free starter usage, no card)
#   https://ollama.com/settings/keys
OLLAMACLOUD_API_KEY=
OLLAMACLOUD_MODEL=gpt-oss:20b

# Chutes (free ~100 req/day, no card)
#   https://chutes.ai
CHUTES_API_KEY=
CHUTES_MODEL=unsloth/Mistral-Nemo-Instruct-2407-TEE

# TokenReply (free models on Default tier; allowances check-in gated)
#   Verified free IDs: gemini-3.7-flash-default-free, nemotron-3-ultra-free, mimo-v2.5-free
#   https://www.tokenreply.com
TOKENREPLY_API_KEY=
TOKENREPLY_MODEL=gemini-3.7-flash-default-free

# Agnes AI (OpenAI-compatible, fast first responder)
#   https://agnes.ai
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# LLM7 (OpenAI-compatible hub)
#   https://llm7.io
LLM7_API_KEY=
LLM7_MODEL=minimax-m2.7

# Cehpoint AI (zero auth, unlimited free calls)
#   No signup required
CEHPOINT_API_KEY=cehpoint-free
CEHPOINT_MODEL=cehpoint-ai

# ZhipuAI (GLM-4.7-Flash, reasoning model salvage)
#   https://open.bigmodel.cn
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=GLM-4.7-Flash

# KiraAI (150M free tokens/day, OpenAI-compatible)
#   https://kiraai.vn
KIRA_API_KEY=
KIRA_MODEL=kira-3.5-flash

# Cloudflare Workers AI (10,000 free neurons/day)
#   https://dash.cloudflare.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# HuggingFace Inference Router
#   https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cohere (20 RPM free tier)
#   https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-02-2025

# Alibaba DashScope / Qwen International (1M free tokens per model, 90-day trial)
#   https://dashscope-intl.aliyuncs.com
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-flash

# OmniRoute (self-hosted local LLM router, 390 models, $0)
#   Setup: npm install -g omniroute → omniroute (listens on :20128)
#   API key is whatever you set in its dashboard
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://host.docker.internal:20128
OMNIROUTE_MODEL=auto/best-fast

# FreeLLMAPI (self-hosted pooled router)
#   Setup: scripts/setup_freellm.sh deploys on compose network
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_KEY=
FREELLMAPI_MODEL=auto

# Local emergency chat model inside ollama container (last-resort lane)
#   Thinking tasks only — benchmarked 6/6 JSON but ~50s CPU latency
OLLAMA_LOCAL_MODEL=qwen2.5:3b-instruct

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Options: ollama | gemini | local | auto
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# ─── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Dashboard + RCON & Ports ──────────────────────────────────────────────────
# Must match the Minecraft server's RCON password (set in docker-compose).
RCON_PASSWORD=changeme
DASHBOARD_PORT=3003
BROKER_PORT=3001
MEMORY_PORT=3002
MC_PORT=25565
